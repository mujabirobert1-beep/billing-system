{
  "name": "cloudifi/backend",
  "description": "CloudiFi Laravel 11 backend for ISP billing, monitoring, and auto-config Routers.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "illuminate/auth": "^11.0",
    "illuminate/cache": "^11.0",
    "illuminate/console": "^11.0",
    "illuminate/container": "^11.0",
    "illuminate/contracts": "^11.0",
    "illuminate/database": "^11.0",
    "illuminate/events": "^11.0",
    "illuminate/filesystem": "^11.0",
    "illuminate/http": "^11.0",
    "illuminate/mail": "^11.0",
    "illuminate/queue": "^11.0",
    "illuminate/routing": "^11.0",
    "illuminate/session": "^11.0",
    "illuminate/support": "^11.0",
    "illuminate/translation": "^11.0",
    "illuminate/view": "^11.0",
    "illuminate/cookie": "^11.0",
    "illuminate/foundation": "^11.0",
    "illuminate/notifications": "^11.0",
    "illuminate/validation": "^11.0",
    "vlucas/phpdotenv": "^5.5",
    "guzzlehttp/guzzle": "^7.0",
    "routeros/routeros-api": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"if (!file_exists('bootstrap')) mkdir('bootstrap');\""
    ]
  }
}
